
#!/bin/bash
set -xeuo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

cat >> /etc/ecs/ecs.config <<EOF
ECS_CLUSTER=${cluster_name}
ECS_RESERVED_MEMORY=256
ECS_LOGLEVEL=info
ECS_AVAILABLE_LOGGING_DRIVERS=["json-file","awslogs"]
EOF

systemctl enable --now --no-block ecs.service

timeout 300 bash -c 'until curl -sf http://localhost:51678/v1/metadata > /tmp/ecs-metadata.json; do echo "Waiting for ECS agent..."; sleep 5; done'

curl -fsSL -H "Authorization: Api-Token ${dynatrace_token}" \
  "https://${dynatrace_tenant}.live.dynatrace.com/api/v1/deployment/installer/unix" \
  | bash -s -- --set-monitoring-mode=infra-only
